# Required. Anthropic API key used to call Claude (lib/anthropic.ts).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Feature flag for rate limiting (lib/rateLimit.ts).
# Set to "false" to disable, anything else (or unset) enables it.
# Rate limiting also no-ops automatically if the Upstash vars below aren't set.
RATE_LIMIT_ENABLED=false

# Optional. Upstash Redis REST credentials, used for rate limiting.
# Leave blank for local dev — rate limiting is skipped without them.
# Create a database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
